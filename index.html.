<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>IT INTERNATIONAL ACADEMY TV</title>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>
    <style>
        body { margin: 0; background: #000; color: #fff; font-family: sans-serif; overflow: hidden; }
        .header { background: #111; padding: 10px; display: flex; align-items: center; justify-content: center; border-bottom: 2px solid red; cursor: pointer; }
        .station-name { font-weight: bold; font-size: 14px; letter-spacing: 1px; }
        .info-bar { display: flex; justify-content: space-between; align-items: center; padding: 10px 15px; background: rgba(0,0,0,0.8); }
        .program-title { color: #fff; font-size: 12px; font-weight: bold; border-left: 3px solid red; padding-left: 10px; text-transform: uppercase; }
        .live-tag { background: red; color: white; padding: 4px 8px; font-size: 12px; font-weight: bold; border-radius: 2px; animation: blink 1s infinite; }
        @keyframes blink { 0% { opacity: 1; } 50% { opacity: 0.5; } 100% { opacity: 1; } }
        .video-container { position: relative; width: 100vw; height: calc(100vh - 100px); background: #000; display: flex; align-items: center; justify-content: center; }
        video { width: 100%; height: 100%; object-fit: contain; }
        #admin-panel { display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: #222; padding: 20px; border: 2px solid red; z-index: 100; width: 85%; box-sizing: border-box; }
        input { width: 100%; padding: 12px; margin: 10px 0; background: #333; color: #fff; border: 1px solid #444; box-sizing: border-box; }
        button { width: 100%; padding: 12px; background: red; color: white; border: none; font-weight: bold; cursor: pointer; text-transform: uppercase; }
        .fs-btn { position: absolute; bottom: 20px; right: 20px; background: rgba(255,0,0,0.8); color: white; border: none; padding: 12px 18px; border-radius: 5px; font-size: 12px; font-weight: bold; z-index: 10; }
    </style>
</head>
<body>

<div class="header" onclick="checkAdminClick()">
    <div class="station-name">IT INTERNATIONAL ACADEMY TV</div>
</div>

<div class="info-bar">
    <div id="program-display" class="program-title">WAITING FOR FEED...</div>
    <div class="live-tag">ITA TV LIVE</div>
</div>

<div class="video-container" id="main-stage">
    <video id="main-video" autoplay muted playsinline loop></video>
    <button class="fs-btn" onclick="toggleFull()">FULLSCREEN</button>
</div>

<div id="admin-panel">
    <input type="password" id="admin-key" placeholder="Access Key">
    <input type="text" id="new-video" placeholder="Direct MP4 URL">
    <input type="text" id="new-program" placeholder="Program Title (e.g. CYBERSECURITY)">
    <button onclick="updateStation()">GO LIVE</button>
    <button onclick="closeAdmin()" style="background:#444; margin-top:10px">CANCEL</button>
</div>

<script>
    // Updated with credentials from 4921.jpg
    const firebaseConfig = {
        apiKey: "AIzaSyCHTsYMsXuH55f18tKDL9gSk_h_UjKPjwU",
        authDomain: "ita-tv-db475.firebaseapp.com",
        databaseURL: "https://ita-tv-db475-default-rtdb.firebaseio.com",
        projectId: "ita-tv-db475",
        storageBucket: "ita-tv-db475.appspot.com",
        messagingSenderId: "745163337566",
        appId: "1:745163337566:web:2bb85775e8dcc1ee9ca9cf",
        measurementId: "G-2DM4BZTS8Q"
    };
    
    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();
    const videoElement = document.getElementById('main-video');
    const titleElement = document.getElementById('program-display');

    // Listen for live updates
    db.ref("station").on("value", (snapshot) => {
        const data = snapshot.val();
        if (data) {
            if (videoElement.src !== data.mainVideo) {
                videoElement.src = data.mainVideo;
                videoElement.play().catch(e => console.log("Autoplay check"));
            }
            titleElement.innerText = data.programName || "ON AIR";
        }
    });

    // Admin Access
    let clickCount = 0;
    function checkAdminClick() {
        clickCount++;
        if (clickCount === 3) { 
            document.getElementById('admin-panel').style.display = 'block'; 
            clickCount = 0; 
        }
        setTimeout(() => { clickCount = 0; }, 1500);
    }

    function updateStation() {
        const key = document.getElementById('admin-key').value;
        if(key === "2024") {
            const vLink = document.getElementById('new-video').value;
            const pName = document.getElementById('new-program').value;
            db.ref("station").update({ 
                mainVideo: vLink, 
                programName: pName 
            }).then(() => {
                alert("Station Updated!");
                closeAdmin();
            });
        } else {
            alert("Incorrect Access Key");
        }
    }

    function closeAdmin() { 
        document.getElementById('admin-panel').style.display = 'none'; 
    }
    
    // Landscape Lock and Fullscreen Logic
    function toggleFull() {
        const stage = document.getElementById('main-stage');
        if (!document.fullscreenElement) {
            stage.requestFullscreen().then(() => {
                // Forces orientation sideways for mobile devices
                if (screen.orientation && screen.orientation.lock) {
                    screen.orientation.lock('landscape').catch(e => console.log("Orientation lock not supported"));
                }
            }).catch(err => alert("Fullscreen Error: " + err.message));
        } else {
            document.exitFullscreen();
            if (screen.orientation && screen.orientation.unlock) { 
                screen.orientation.unlock(); 
            }
        }
    }
</script>
</body>
</html>
